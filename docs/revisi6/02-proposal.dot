digraph workflow {
graph [rankdir=TB, bgcolor="#fcfcf8", pad=0.4, nodesep=0.3, ranksep=0.52, splines=polyline, fontname="DejaVu Sans", fontsize=19, labelloc=t, label="02 · Proposal: audit serentak, perbaikan terarah"];
node [shape=box, style="rounded,filled", fillcolor="#edf4ed", color="#6c8977", fontcolor="#193b33", fontname="DejaVu Sans", fontsize=11, margin="0.16,0.12"];
edge [color="#89968e", fontname="DejaVu Sans", fontsize=9, fontcolor="#47574e", arrowsize=0.65];
  INPUT [label="Masukan yang tersedia dan\nversi: ide, literatur atau\nproposal"];
  ENOUGH [label="Bahan minimum untuk tugas ini\ndapat dinilai?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  INTENT [label="Ringkas maksud, cakupan,\nketidakpastian dan keputusan\nlama"];
  CONFIRM [label="Pengguna mengonfirmasi maksud\nsubstantif?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  FORK [label="Audit pada snapshot yang sama;\nAND split", fillcolor="#e9e3f4", color="#9381ac"];
  A1 [label="Aturan, struktur dan sumber\nketentuan"];
  A2 [label="Masalah, gap dan keselarasan\ntujuan"];
  A3 [label="Literatur, konteks dan\ndukungan klaim"];
  A4 [label="Desain, sampel, pengukuran dan\nanalisis"];
  A5 [label="Etik, izin, privasi dan\nkelayakan"];
  JOIN [label="Semua audit relevan selesai\npada versi yang sama?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  FIND [label="Gabungkan status, bukti, isu\npenghambat dan dependensi"];
  CORE [label="Perlu keputusan arah inti?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  OPTIONS [label="Tawarkan opsi, konsekuensi dan\naktor yang perlu memutuskan"];
  DECISION [label="Keputusan substantif tersedia\ndan tercatat?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  FIX [label="Perbaiki hanya target\nterdampak; Bab I–III mengikuti\ndependensi"];
  FEASIBLE [label="Periksa bukti dan uji relevan;\ndry run tidak menjadi hasil\nnyata"];
  LOCAL [label="Gerbang target memadai?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  CROSS [label="Periksa matriks lintas bab dan\nsanggahan berbukti"];
  FINAL [label="Semua gerbang wajib mutakhir;\ntanpa isu penghambat?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  EXPLAIN [label="Jelaskan alasan, bukti,\nalternatif dan batas dengan\nsumber"];
  UNDERSTAND [label="Keputusan utama dipahami?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  HELP [label="Bimbing area belum dipahami;\nlatihan dalam budget"];
  READY [label="Proposal siap ditinjau —\nlanjut diagram 04", shape=box, fillcolor="#e4edf9", color="#728caa", peripheries=2];
  RETRY [label="Isu kembali ke kendali budget\ndan target — diagram 01", shape=box, fillcolor="#e4edf9", color="#728caa", peripheries=2];
  WAIT [label="Minta bahan/keputusan yang\nkurang; tahan hanya tugas\nterkait", fillcolor="#fae9e4", color="#b67c6c"];
  INPUT -> ENOUGH;
  ENOUGH -> INTENT [label="Ya"];
  ENOUGH -> WAIT [label="Belum"];
  INTENT -> CONFIRM;
  CONFIRM -> FORK [label="Sesuai"];
  CONFIRM -> WAIT [label="Belum sesuai / belum dijawab"];
  FORK -> A1;
  FORK -> A2;
  FORK -> A3;
  FORK -> A4;
  FORK -> A5;
  A1 -> JOIN;
  A2 -> JOIN;
  A3 -> JOIN;
  A4 -> JOIN;
  A5 -> JOIN;
  JOIN -> FIND [label="Ya: status lengkap, bukan otomatis lolos"];
  JOIN -> WAIT [label="Belum / versi berubah"];
  FIND -> CORE;
  CORE -> OPTIONS [label="Ya"];
  CORE -> FIX [label="Tidak"];
  OPTIONS -> DECISION;
  DECISION -> INPUT [label="Ada: perbarui arah dan versi"];
  DECISION -> WAIT [label="Belum"];
  FIX -> FEASIBLE [label="Lewati keluaran yang tetap sah"];
  FEASIBLE -> LOCAL;
  LOCAL -> CROSS [label="Memadai"];
  LOCAL -> RETRY [label="Perlu revisi"];
  LOCAL -> WAIT [label="Belum dapat dinilai"];
  CROSS -> FINAL;
  FINAL -> EXPLAIN [label="Ya"];
  FINAL -> RETRY [label="Tidak"];
  EXPLAIN -> UNDERSTAND;
  UNDERSTAND -> READY [label="Ya: bukan tes hafalan"];
  UNDERSTAND -> HELP [label="Sebagian: budget tersedia"];
  UNDERSTAND -> RETRY [label="Budget habis / isu substantif"];
  HELP -> EXPLAIN [label="Setelah penjelasan bermakna"];
  WAIT -> INPUT [label="Masukan/prasyarat berubah"];
}
