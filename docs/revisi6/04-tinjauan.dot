digraph workflow {
graph [rankdir=TB, bgcolor="#fcfcf8", pad=0.4, nodesep=0.3, ranksep=0.52, splines=polyline, fontname="DejaVu Sans", fontsize=19, labelloc=t, label="04 · Tinjauan dan keputusan: proposal berbeda dari pengesahan akhir"];
node [shape=box, style="rounded,filled", fillcolor="#edf4ed", color="#6c8977", fontcolor="#193b33", fontname="DejaVu Sans", fontsize=11, margin="0.16,0.12"];
edge [color="#89968e", fontname="DejaVu Sans", fontsize=9, fontcolor="#47574e", arrowsize=0.65];
  TYPE [label="Jenis paket yang dituju?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  PG [label="Proposal: gerbang internal dan\nversi sudah memadai?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  PE [label="Ekspor proposal dengan\nmanifest versi"];
  PV [label="Tampilan dan kelengkapan\nproposal benar?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  PR [label="Tinjauan proposal tersedia dan\nmengizinkan langkah berikut?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  PS [label="Seminar proposal diwajibkan\nmenurut aturan terverifikasi?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  PSE [label="Seminar proposal; catat\nkeputusan aktual dan versinya"];
  PD [label="Keputusan proposal untuk versi\nini?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  PA [label="Milestone proposal disetujui;\ncek izin kegiatan secara\nterpisah", shape=box, fillcolor="#e4edf9", color="#728caa", peripheries=2];
  PW [label="Menunggu aturan/keputusan\nproposal; latihan boleh\nberjalan", fillcolor="#fae9e4", color="#b67c6c"];
  PRESUME [label="Checkpoint proposal yang\ntertunda menurut isu?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  FG [label="Akhir: gerbang internal dan\nversi sudah memadai?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  FE [label="Ekspor naskah dan paket\nreproduksi sesuai akses"];
  FV [label="Tampilan dan kelengkapan paket\nakhir benar?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  FR [label="Tinjauan akhir tersedia dan\nsyarat sidang terpenuhi?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  EXAM [label="Sidang akhir; catat bukti\nkeputusan penguji"];
  FD [label="Keputusan sidang akhir?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  FIX [label="Selesaikan revisi akhir;\npertahankan versi dan isu"];
  VER [label="Revisi diterima pihak\nberwenang untuk versi ini?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  FINAL [label="Seluruh syarat final dan bukti\npengesahan versi cocok?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  ARCHIVE [label="Arsip versi final disetujui\nbeserta bukti dan paket\nreproduksi", shape=box, fillcolor="#e4edf9", color="#728caa", peripheries=2];
  FW [label="Menunggu bukti/keputusan\nakhir; jangan mengarang\npengesahan", fillcolor="#fae9e4", color="#b67c6c"];
  FRESUME [label="Checkpoint akhir yang tertunda\nmenurut isu?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  RETRY [label="Catat isu; kembali ke satu\ntarget lewat diagram 01", shape=box, fillcolor="#e4edf9", color="#728caa", peripheries=2];
  DRAFT [label="Boleh ekspor draf berlabel\nbelum lolos jika akses sah", shape=box, fillcolor="#e4edf9", color="#728caa", peripheries=2];
  TYPE -> PG [label="Proposal"];
  TYPE -> FG [label="Skripsi akhir"];
  PG -> PE [label="Ya"];
  PG -> DRAFT [label="Belum"];
  PE -> PV;
  PV -> PR [label="Ya"];
  PV -> RETRY [label="Tidak"];
  PR -> PS [label="Ya"];
  PR -> RETRY [label="Perlu revisi"];
  PR -> PW [label="Belum diketahui/tersedia"];
  PS -> PSE [label="Ya"];
  PS -> PD [label="Tidak: ada dasar aturan"];
  PS -> PW [label="Aturan belum jelas"];
  PSE -> PD;
  PD -> PA [label="Disetujui sesuai bukti"];
  PD -> RETRY [label="Revisi / belum disetujui"];
  PD -> PW [label="Keputusan belum tersedia"];
  PW -> PRESUME [label="Aturan/keputusan baru tercatat"];
  PRESUME -> PR [label="Tinjauan pembimbing"];
  PRESUME -> PS [label="Aturan seminar"];
  PRESUME -> PD [label="Keputusan proposal yang sudah diproses"];
  FG -> FE [label="Ya"];
  FG -> DRAFT [label="Belum"];
  FE -> FV;
  FV -> FR [label="Ya"];
  FV -> RETRY [label="Tidak"];
  FR -> EXAM [label="Ya, sesuai aturan"];
  FR -> RETRY [label="Perlu revisi"];
  FR -> FW [label="Belum"];
  EXAM -> FD;
  FD -> FINAL [label="Lulus tanpa revisi yang diwajibkan"];
  FD -> FIX [label="Lulus dengan revisi"];
  FD -> RETRY [label="Belum lulus / perbaikan substantif"];
  FD -> FW [label="Bukti keputusan belum ada"];
  FIX -> VER;
  VER -> FINAL [label="Ya"];
  VER -> RETRY [label="Belum memadai"];
  VER -> FW [label="Belum dinilai"];
  FINAL -> ARCHIVE [label="Ya"];
  FINAL -> FW [label="Syarat/bukti belum lengkap"];
  FW -> FRESUME [label="Bukti baru; jangan ulang kegiatan yang sudah sah"];
  FRESUME -> FR [label="Syarat sebelum sidang"];
  FRESUME -> FD [label="Keputusan sidang yang sudah terjadi"];
  FRESUME -> VER [label="Verifikasi revisi akhir"];
  FRESUME -> FINAL [label="Kelengkapan pengesahan"];
}
