digraph workflow {
graph [rankdir=TB, bgcolor="#fcfcf8", pad=0.4, nodesep=0.3, ranksep=0.52, splines=polyline, fontname="DejaVu Sans", fontsize=19, labelloc=t, label="03 · Pelaksanaan: izin, rencana, data dan hasil yang sah"];
node [shape=box, style="rounded,filled", fillcolor="#edf4ed", color="#6c8977", fontcolor="#193b33", fontname="DejaVu Sans", fontsize=11, margin="0.16,0.12"];
edge [color="#89968e", fontname="DejaVu Sans", fontsize=9, fontcolor="#47574e", arrowsize=0.65];
  START [label="Inventaris data, instrumen,\nhasil eksternal dan\nketerpaparan hasil"];
  EXIST [label="Data untuk tujuan ini sudah\ntersedia?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  ORIGIN [label="Audit asal, akses, persetujuan\ndan mutu data lama"];
  GO [label="Data layak digunakan untuk\ntujuan ini?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  INSTR [label="Susun instrumen dan protokol\nsesuai rancangan"];
  PNEED [label="Uji coba diperlukan?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  PPERM [label="Persetujuan uji coba yang\ndiwajibkan tersedia?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  PILOT [label="Uji coba nyata dan evaluasi\ninstrumen sesuai protokol"];
  GI [label="Instrumen layak; alasan dan\nbukti cukup?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  PLAN [label="Versikan rencana; catat asumsi\ndan keterpaparan hasil; jangan\nmundurkan tanggal"];
  NEED [label="Perlu pengumpulan data\nbaru/tambahan?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  PERMIT [label="Syarat kegiatan dan aturan\npenghentian terpenuhi?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  COLLECT [label="Kumpulkan data nyata; simpan\nasal dan bukti prosedur"];
  CLEAN [label="Raw tetap; audit buku kode,\nmissing dan transformasi\nmenjadi versi baru"];
  GC [label="Data siap untuk analisis yang\ndipilih?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  MODE [label="Sumber perhitungan yang\ndigunakan?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  ENGINE [label="Modul metode didukung dan\nlulus benchmark relevan?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  RUN [label="Eksekusi; rekam versi,\nestimator, parameter dan\ndiagnostik"];
  IMPORT [label="Impor hasil eksternal; audit\nperangkat, pengaturan dan\nprovenance"];
  GA [label="Perhitungan dan interpretasi\nmemadai untuk klaim?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  WRITE [label="Hasil sah; tulis naskah\nberbukti lalu paket akhir —\ndiagram 04", shape=box, fillcolor="#e4edf9", color="#728caa", peripheries=2];
  HANDOFF [label="Handoff metode; jangan\nmengganti rancangan demi alat", fillcolor="#fae9e4", color="#b67c6c"];
  WAIT [label="Tahan kegiatan terkait; minta\nbukti/izin/keputusan yang\ntepat", fillcolor="#fae9e4", color="#b67c6c"];
  RETRY [label="Isu ke diagram 01; amandemen\ntercatat dan turunan usang", shape=box, fillcolor="#e4edf9", color="#728caa", peripheries=2];
  START -> EXIST;
  EXIST -> ORIGIN [label="Ya"];
  EXIST -> INSTR [label="Belum"];
  ORIGIN -> GO;
  GO -> PLAN [label="Ya"];
  GO -> WAIT [label="Belum / tidak layak"];
  INSTR -> PNEED;
  PNEED -> PPERM [label="Ya"];
  PNEED -> GI [label="Tidak relevan dengan alasan"];
  PNEED -> WAIT [label="Belum diketahui"];
  PPERM -> PILOT [label="Ya / tidak diwajibkan dengan dasar"];
  PPERM -> WAIT [label="Belum"];
  PILOT -> GI;
  GI -> PLAN [label="Ya"];
  GI -> RETRY [label="Perlu revisi"];
  GI -> WAIT [label="Bukti kurang"];
  PLAN -> NEED;
  NEED -> PERMIT [label="Ya: alasan ilmiah tercatat"];
  NEED -> CLEAN [label="Tidak"];
  PERMIT -> COLLECT [label="Ya"];
  PERMIT -> WAIT [label="Belum"];
  COLLECT -> CLEAN;
  CLEAN -> GC;
  GC -> MODE [label="Ya"];
  GC -> RETRY [label="Perlu revisi"];
  GC -> WAIT [label="Belum dapat dinilai"];
  MODE -> ENGINE [label="Dihitung oleh modul aplikasi"];
  MODE -> IMPORT [label="Keluaran eksternal yang tersedia"];
  ENGINE -> RUN [label="Ya"];
  ENGINE -> HANDOFF [label="Tidak / alat belum tersedia"];
  HANDOFF -> WAIT;
  RUN -> GA;
  IMPORT -> GA;
  GA -> WRITE [label="Memadai: hasil tidak signifikan boleh sah"];
  GA -> RETRY [label="Kesalahan / penanganan perlu revisi"];
  GA -> WAIT [label="Bukti/capability kurang"];
  WAIT -> START [label="Prasyarat berubah; gunakan ulang keluaran sah"];
}
