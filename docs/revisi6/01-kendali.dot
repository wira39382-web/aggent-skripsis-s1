digraph workflow {
graph [rankdir=TB, bgcolor="#fcfcf8", pad=0.4, nodesep=0.3, ranksep=0.52, splines=polyline, fontname="DejaVu Sans", fontsize=19, labelloc=t, label="01 · Kendali proyek berbasis bukti dan dependensi"];
node [shape=box, style="rounded,filled", fillcolor="#edf4ed", color="#6c8977", fontcolor="#193b33", fontname="DejaVu Sans", fontsize=11, margin="0.16,0.12"];
edge [color="#89968e", fontname="DejaVu Sans", fontsize=9, fontcolor="#47574e", arrowsize=0.65];
  START [label="Inventaris ide, proposal,\ndokumen, data, hasil dan\nkeputusan"];
  RULES [label="Petakan aturan, kewenangan,\ncapability dan tujuan saat ini"];
  QUEUE [label="Susun tugas menurut\ndependensi; gunakan ulang\nversi yang masih sah"];
  NEXT [label="Ada tugas siap dan diperlukan?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  TASK [label="Pilih satu tugas: literatur,\nproposal, data, analisis atau\nnaskah"];
  WORK [label="Kerjakan pada snapshot input;\ncatat sumber, proses dan biaya"];
  CHECK [label="Hasil audit lokal?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  SAVE [label="Simpan versi dan bukti; tandai\nturunan terdampak usang"];
  READY [label="Tujuan paket saat ini siap\nditinjau?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  PACK [label="Ekspor dan keputusan per fase\n— diagram 04"];
  DONE [label="Paket dan status aktual\ntersimpan; bukan persetujuan\notomatis", shape=box, fillcolor="#e4edf9", color="#728caa", peripheries=2];
  ISSUE [label="Catat isu stabil, akar masalah\ndan kriteria selesai"];
  BUDGET [label="Upaya otomatis masih beralasan\ndan dalam budget?", shape=diamond, fillcolor="#fcf0d8", color="#b29355"];
  TARGET [label="Pilih satu target terdampak;\njangan reset riwayat isu"];
  DIAG [label="Diagnosis teknis; kegagalan\nalat bukan temuan penelitian"];
  HOLD [label="Jeda tugas terkait; lanjutkan\ntugas independen yang siap", fillcolor="#fae9e4", color="#b67c6c"];
  ESC [label="Minta keputusan atau budget\nbaru; simpan state", fillcolor="#fae9e4", color="#b67c6c"];
  START -> RULES;
  RULES -> QUEUE;
  QUEUE -> NEXT;
  NEXT -> TASK [label="Ada"];
  NEXT -> READY [label="Tidak ada tugas tersisa"];
  NEXT -> HOLD [label="Tugas tersisa tetapi prasyarat terblokir"];
  TASK -> WORK;
  WORK -> CHECK;
  CHECK -> SAVE [label="Memadai / tidak relevan beralasan"];
  CHECK -> ISSUE [label="Perlu revisi"];
  CHECK -> DIAG [label="Alat gagal"];
  CHECK -> HOLD [label="Belum dapat dinilai"];
  DIAG -> ISSUE;
  SAVE -> READY;
  READY -> PACK [label="Ya: gerbang scope terpenuhi"];
  READY -> QUEUE [label="Belum: tugas baru yang dapat dikerjakan teridentifikasi"];
  READY -> HOLD [label="Belum: syarat/bukti yang diperlukan belum jelas"];
  PACK -> DONE;
  ISSUE -> BUDGET;
  BUDGET -> TARGET [label="Ya, ada diagnosis/perubahan berarti"];
  BUDGET -> ESC [label="Tidak / perlu keputusan manusia"];
  TARGET -> QUEUE;
  HOLD -> QUEUE [label="Tugas independen siap atau prasyarat berubah"];
  ESC -> QUEUE [label="Keputusan dan budget baru tercatat"];
}
